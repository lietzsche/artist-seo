APP_ENV=development
# 관리자 계정(선택). 둘 다 넣으면 API 시작 시 계정을 만들고, 비밀번호를 바꾸면 재시작 때 반영된다.
# 비워 두면 첫 접속 때 웹 화면에서 관리자 계정을 설정한다.
ADMIN_EMAIL=
ADMIN_PASSWORD=
APP_SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql+psycopg://artist:change-me@db:5432/artist
POSTGRES_DB=artist
POSTGRES_USER=artist
POSTGRES_PASSWORD=change-me
PUBLIC_ORIGIN=http://localhost:8080
API_BASE_URL=/api/v1
MEDIA_BASE_URL=/media
STORAGE_ROOT=/data
MAX_FILE_BYTES=5368709120
MAX_TOTAL_BYTES=107374182400
MIN_FREE_BYTES=5368709120
UPLOAD_EXPIRY_HOURS=24
TRASH_RETENTION_DAYS=30
SESSION_COOKIE_SECURE=false
MEDIA_WORKER_CONCURRENCY=1
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
# true이면 API 시작 시 데모 데이터를 넣는다(이미 있으면 건너뜀)
SEED_DEMO_DATA=false
# 8080 포트를 열 주소. 운영(터널)에서는 127.0.0.1 권장
GATEWAY_BIND=0.0.0.0
# 선택 사항: cloudflared profile에서만 사용
CLOUDFLARE_TUNNEL_TOKEN=

