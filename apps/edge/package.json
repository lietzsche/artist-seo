{
  "name": "artist-portfolio-edge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.21.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "npm --prefix ../web run dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:web": "npm --prefix ../web ci && npm --prefix ../web run build",
    "db:migrate:local": "wrangler d1 migrations apply artist-portfolio --local",
    "create-admin": "node scripts/create-admin.mjs",
    "deploy": "bash scripts/deploy.sh",
    "deploy:ci": "bash scripts/deploy-ci.sh"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "hono": "4.13.15",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.11",
    "@cloudflare/workers-types": "5.20261101.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.156.0"
  }
}
